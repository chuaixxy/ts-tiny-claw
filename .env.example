# 通用 LLM 凭证（OpenAI / Anthropic 兼容端点共用）
LLM_API_KEY=your_api_key_here
# 注意：baseURL 需指向「含版本前缀」的根，SDK 会再拼 /chat/completions
# 例如网关是 .../v1/chat/completions → 这里填 .../v1
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4.5-air

# --- 常用厂商示例（按需取消注释并替换上面的三项）---
# 智谱 GLM
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# LLM_MODEL=glm-4.5-air

# DeepSeek（官方默认已带 /v1 行为；也可显式写 .../v1）
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# 豆包 (火山方舟)
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=doubao-pro-32k

# --- 飞书机器人（Webhook + OpenAPI 回贴）---
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_ENCRYPT_KEY=
# FEISHU_VERIFY_TOKEN=
# （也可用 FEISHU_VERIFICATION_TOKEN，与 VERIFY_TOKEN 二选一）
# 群聊识别 @ 本机器人（mention 里经常没有 app_id）
# FEISHU_BOT_OPEN_ID=
# FEISHU_BOT_NAME=
# 意图 L2 轻量分类（默认开启；设 0 关闭）
# FEISHU_INTENT_LLM=1
# LLM_INTENT_MODEL=glm-4.5-air
# HTTP 监听端口（默认 48080，对应 Go :48080）
# PORT=48080
#
# 启动模式（也可用命令行参数，默认 cli）:
#   CLAW_MODE=cli       终端对话，不依赖飞书事件订阅
#   CLAW_MODE=webhook   飞书 HTTP Webhook（需公网 URL）
#   CLAW_MODE=ws        飞书长连接（本地可收消息，无需公网 Webhook）
# 引擎内部 Turn/Phase 详细日志（默认关闭，CLI 只显示 Reporter 气泡）:
# CLAW_VERBOSE=1
